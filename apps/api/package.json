    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^10.1.0",
    "@fastify/websocket": "^11.3.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.3.3",
    "fastify-plugin": "^6.0.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.3",
    "mongoose": "^9.7.4",
    "nats": "^2.29.3",
    "resend": "^6.17.2",
    "zod": "^3.25.51"
  },
  "devDependencies": {
    "@mahatest/eslint-config": "workspace:*",
    "@mahatest/typescript-config": "workspace:*",
    "@types/bcryptjs": "^3.0.0",
