NODE_ENV=development
PORT=4000
HOST=0.0.0.0
MONGODB_URI=mongodb://127.0.0.1:27017/mahatest
REDIS_URL=redis://127.0.0.1:6379
JWT_ACCESS_SECRET=dev-access-secret-change-me-32chars!!
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-32chars!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=dev-cookie-secret-change-me-32chars!!
WEB_ORIGIN=http://localhost:3000
APP_NAME=MahaTest
UPLOAD_DIR=./uploads
PUBLIC_API_URL=http://localhost:4000
NATS_URL=nats://127.0.0.1:4222

# ─── Email / Resend ────────────────────────────────────────────────────────────
# Get your API key from: https://resend.com/api-keys
# Without this key, emails are only logged to the console (dev mode).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# DEVELOPMENT TESTING:
#   Use the default sender below — BUT emails will only deliver to your own
#   Resend account email address (the one you signed up with).
#
# PRODUCTION:
#   1. Go to https://resend.com/domains and add your domain (e.g., mahatest.com)
#   2. Add the DNS records Resend provides (MX, TXT, DKIM)
#   3. Wait for domain verification (~5–10 min)
#   4. Update EMAIL_FROM to your verified domain sender below
EMAIL_FROM=MahaTest <onboarding@resend.dev>
# EMAIL_FROM=MahaTest <noreply@yourdomain.com>

# ─── Option 2: SMTP / Gmail (Send real emails to ANY address) ─────────────────
# Example for Gmail (use a 16-character Google App Password: https://myaccount.google.com/apppasswords):
# SMTP_SERVICE=gmail
# SMTP_USER=yourgmail@gmail.com
# SMTP_PASS=your-16-char-app-password
# EMAIL_FROM=MahaTest <yourgmail@gmail.com>
#
# Example for Custom / Brevo / Mailgun / AWS SES SMTP:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password

# ── Seed admin accounts ────────────────────────────────────────────────────────
# These accounts are AUTOMATICALLY created / promoted on every API startup.
# - If the account doesn't exist → it's created with the specified role
# - If it already exists → role is updated and email is marked verified
# - Seed accounts skip OTP verification (emailVerified = true)
# - Leave empty to disable seeding (safe for production after first deploy)
SUPER_ADMIN_EMAIL=superadmin@yourdomain.com
SUPER_ADMIN_PASSWORD=YourStrongPassword1
SUPER_ADMIN_NAME=Super Admin

CONTENT_MANAGER_EMAIL=manager@yourdomain.com
CONTENT_MANAGER_PASSWORD=YourStrongPassword1
CONTENT_MANAGER_NAME=Content Manager
